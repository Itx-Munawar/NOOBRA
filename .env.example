# NOOBRA — copy this file to `.env` and fill in your free API keys.
# Never commit your real `.env` — it holds secrets.
# cp .env.example .env        (Windows: copy .env.example .env)

# --- Provider selection: gemini | groq | openrouter ---
NOOBRA_PROVIDER=gemini

# --- Gemini (free tier) — get a key at https://aistudio.google.com/app/apikey ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Groq (free tier) — get a key at https://console.groq.com/keys ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenRouter (optional, free models) — https://openrouter.ai/keys ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# --- Optional toggles ---
# NOOBRA_VOICE_ENABLED=true
# NOOBRA_MEMORY_ENABLED=true
